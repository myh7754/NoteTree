# 클라우드 동기화를 켜려면 이 두 값을 .env.local 에 넣으세요 (배포는 Vercel 환경변수).
# 없으면 앱은 지금까지처럼 브라우저(IndexedDB)에만 저장합니다.
#
# Supabase 대시보드 → Project Settings → API Keys 에서 복사합니다.
# Publishable 키(sb_publishable_...) 또는 옛 anon 키만 씁니다.
# ⚠️ Secret 키(sb_secret_...)·service_role 키는 절대 넣지 마세요 — VITE_* 값은 번들에
# 그대로 실려 누구나 볼 수 있고, 그 키는 RLS를 우회해 모든 사용자의 데이터를 읽고 지웁니다.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# ── 모니터링 ──────────────────────────────────────────────────
# Sentry DSN과 PostHog 토큰은 코드에 기본값으로 박혀 있다(src/lib/sentry.ts, analytics.ts).
# 숨길 수 없는 값이라(번들에 그대로 실린다) 환경변수로 관리할 실익이 없어서다.
# 다른 Sentry·PostHog 프로젝트로 보내고 싶을 때만 아래 변수로 덮어쓴다.
#
# 로컬 개발에서는 값이 있든 없든 전송하지 않는다 (import.meta.env.DEV 검사).

# VITE_SENTRY_DSN=<값>
# VITE_POSTHOG_KEY=<값>
# VITE_POSTHOG_HOST=https://us.i.posthog.com
