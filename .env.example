# 클라우드 동기화를 켜려면 이 두 값을 .env.local 에 넣으세요 (배포는 Vercel 환경변수).
# 없으면 앱은 지금까지처럼 브라우저(IndexedDB)에만 저장합니다.
#
# Supabase 대시보드 → Project Settings → API Keys 에서 복사합니다.
# Publishable 키(sb_publishable_...) 또는 옛 anon 키만 씁니다.
# ⚠️ Secret 키(sb_secret_...)·service_role 키는 절대 넣지 마세요 — VITE_* 값은 번들에
# 그대로 실려 누구나 볼 수 있고, 그 키는 RLS를 우회해 모든 사용자의 데이터를 읽고 지웁니다.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# ── 모니터링 (선택) ────────────────────────────────────────────
# 셋 다 **공개 키**다. 브라우저 번들에 그대로 실리는 값이라 숨길 수 없고, 숨길 필요도 없다.
# (그래도 로컬에는 넣지 말 것 — 개발 중 낸 에러·클릭이 실 통계에 섞인다.
#  코드가 import.meta.env.DEV일 때 전송을 끄지만, 이중으로 막아두는 편이 낫다.)
# 값은 Vercel → Settings → Environment Variables 에 Production/Preview 로만 등록한다.

# Sentry 프로젝트의 DSN. 없으면 오류를 보내지 않는다.
VITE_SENTRY_DSN=<값>
# PostHog 프로젝트 키와 수집 호스트. 둘 다 있어야 분석이 켜진다.
VITE_POSTHOG_KEY=<값>
VITE_POSTHOG_HOST=https://us.i.posthog.com
